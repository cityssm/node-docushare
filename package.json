{
  "name": "@cityssm/docushare",
  "version": "2.0.1",
  "description": "An unofficial DocuShare API for NodeJS",
  "keywords": [
    "docushare",
    "document management",
    "xerox"
  ],
  "homepage": "https://github.com/cityssm/node-docushare#readme",
  "bugs": {
    "url": "https://github.com/cityssm/node-docushare/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityssm/node-docushare.git"
  },
  "license": "MIT",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./types": "./types.js"
  },
  "files": [
    "java/bin/*",
    "java/lib/dsJQuery/*",
    "java/lib/jdom/*",
    "java/lib/json/*",
    "defaults.*",
    "index.*",
    "types.*",
    "utilities.*"
  ],
  "scripts": {
    "test:findByHandle": "node --env-file=.dev.env --test \"test/findByHandle.test.js\"",
    "test:findChildren": "node --env-file=.dev.env --test \"test/findChildren.test.js\"",
    "test:getChildren": "node --env-file=.dev.env --test \"test/getChildren.test.js\""
  },
  "dependencies": {
    "debug": "^4.4.3",
    "java-caller": "^6.0.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.3",
    "eslint-config-cityssm": "^54.1.0",
    "prettier-config-cityssm": "^2.2.0"
  }
}
